# Small-memory JVM parameters for consensus node
# Source: hiero-consensus-node/hedera-node/docker/start-small-memory.sh
# Start JFR at JVM startup using default settings and dump to recording.jfr at exit.
JAVA_HEAP_MIN=1g
JAVA_HEAP_MAX=1g
JAVA_OPTS=-XX:+UseG1GC -XX:+AlwaysPreTouch -XX:MaxMetaspaceSize=256M -XX:CompressedClassSpaceSize=48M -Xss256K -XX:ReservedCodeCacheSize=24M -XX:MaxDirectMemorySize=128M -Dio.netty.allocator.type=unpooled -Djava.util.concurrent.ForkJoinPool.common.parallelism=2 -XX:StartFlightRecording=dumponexit=true,settings=default,filename=/opt/hgcapp/services-hedera/HapiApp2.0/output/recording.jfr
MALLOC_ARENA_MAX=1
